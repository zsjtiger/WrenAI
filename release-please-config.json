{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "group-pull-request-title-pattern": "chore${scope}: release janus-rust-core ${version}",
  "packages": {
    "core/janus-core-py": {
      "component": "janus-core-py",
      "release-type": "python",
      "bump-minor-pre-major": true,
      "extra-files": [
        "Cargo.toml",
        {
          "path": "uv.lock",
          "type": "toml",
          "jsonpath": "$.package[?(@.name.value=='janus-core-py')].version"
        }
      ]
    },
    "core/janus": {
      "component": "janus",
      "release-type": "python",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "path": "uv.lock",
          "type": "toml",
          "jsonpath": "$.package[?(@.name.value=='janusai')].version"
        }
      ]
    },
    "core/janus-core-wasm": {
      "component": "janus-core-wasm",
      "release-type": "node",
      "bump-minor-pre-major": true,
      "extra-files": [
        "Cargo.toml"
      ]
    },
    "sdk/janus-langchain": {
      "component": "janus-langchain",
      "release-type": "python",
      "bump-minor-pre-major": true,
      "extra-files": [
        "src/janus_langchain/__init__.py"
      ]
    },
    "sdk/janus-pydantic": {
      "component": "janus-pydantic",
      "release-type": "python",
      "bump-minor-pre-major": true,
      "extra-files": [
        "src/janus_pydantic/__init__.py"
      ]
    },
    "core/janus-core-base/manifest-macro": {
      "component": "janus-manifest-macro",
      "release-type": "rust",
      "bump-minor-pre-major": true
    },
    "core/janus-core-base": {
      "component": "janus-core-base",
      "release-type": "rust",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "path": "Cargo.toml",
          "type": "toml",
          "jsonpath": "$.dependencies.janus-manifest-macro.version"
        }
      ]
    },
    "core/janus-core": {
      "component": "janus-semantic-core",
      "release-type": "simple",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "path": "Cargo.toml",
          "type": "toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "path": "Cargo.toml",
          "type": "toml",
          "jsonpath": "$.workspace.dependencies.janus-core-base.version"
        },
        {
          "path": "/core/janus-core-py/Cargo.toml",
          "type": "toml",
          "jsonpath": "$.dependencies.janus-core.version"
        }
      ]
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "janus-rust-core",
      "components": [
        "janus-manifest-macro",
        "janus-core-base",
        "janus-semantic-core"
      ]
    }
  ]
}
