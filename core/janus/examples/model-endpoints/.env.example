# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Embeddings: an OpenAI-compatible /embeddings endpoint (no key needed for this one).
JANUS_EMBEDDING_BACKEND=api
JANUS_EMBEDDING_API_BASE_URL=http://8.130.170.41:8081/v1
JANUS_EMBEDDING_API_MODEL=qwen3-embedding-4b
# JANUS_EMBEDDING_API_KEY=
# JANUS_EMBEDDING_API_ASYMMETRIC=1   # only if the endpoint needs passage/query input types

# Chat model: DeepSeek's OpenAI-compatible API.
JANUS_LLM_BASE_URL=https://api.deepseek.com
JANUS_LLM_MODEL=deepseek-v4-pro     # or deepseek-flash for lower latency and cost
JANUS_LLM_API_KEY=
