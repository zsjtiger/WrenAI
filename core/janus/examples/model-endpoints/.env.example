# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Embeddings: janus's default local backend (no API). Install one of:
#   pip install 'janusai[memory-onnx]'   (lighter, torch-free)
#   pip install 'janusai[memory]'        (sentence-transformers)
# To use an OpenAI-compatible embedding API instead, set JANUS_EMBEDDING_BACKEND=api
# and JANUS_EMBEDDING_API_BASE_URL / JANUS_EMBEDDING_API_MODEL (see README).

# Chat model: DeepSeek's OpenAI-compatible API.
JANUS_LLM_BASE_URL=https://api.deepseek.com
JANUS_LLM_MODEL=deepseek-v4-pro     # or deepseek-flash for lower latency and cost
JANUS_LLM_API_KEY=
